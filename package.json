{
  "name": "nfcarevet",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "src/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:teste": "npm run dev:host --workspace=frontend-teste",
    "build:common": "npm run build --workspace=@nfcarevet/common",
    "build": "npm run build --workspaces",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:prod:up": "docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose --env-file .env.prod -f docker-compose.prod.yml down",
    "db:generate": "npm run prisma generate --workspace=backend",
    "db:migrate": "npm run prisma migrate dev --workspace=backend",
    "db:seed": "npm run prisma db seed --workspace=backend",
    "db:studio": "npm run prisma studio --workspace=backend"
  }
}
