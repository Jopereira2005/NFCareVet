# Copie este arquivo para .env.prod na VM da Oracle antes de rodar o deploy:
# cp .env.prod.example .env.prod
# Dica: gere segredos fortes com: openssl rand -hex 32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_por_uma_senha_forte_do_banco
POSTGRES_DB=nfcarevet

JWT_SECRET=troque_por_uma_chave_jwt_aleatoria_longa
JWT_EXPIRES_IN=1d

# Mantém o seed automático na primeira inicialização para a apresentação da faculdade
ALLOW_DEMO_SEED=true

# Cloudflare R2 (API S3-Compatible) para Fotos dos Pacientes
R2_ACCOUNT_ID=seu_cloudflare_account_id
R2_ACCESS_KEY_ID=sua_r2_access_key_id
R2_SECRET_ACCESS_KEY=sua_r2_secret_access_key
R2_BUCKET_NAME=nome_do_seu_bucket_r2
# Domínio público do R2 (ex: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev ou https://cdn.seu-dominio.com.br)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
