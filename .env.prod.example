# Copie este arquivo para .env.prod na VM da Oracle antes de rodar o deploy:
# cp .env.prod.example .env.prod
# Dica: gere segredos fortes com: openssl rand -hex 32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_por_uma_senha_forte_do_banco
POSTGRES_DB=nfcarevet

JWT_SECRET=troque_por_uma_chave_jwt_aleatoria_longa
JWT_EXPIRES_IN=1d

# Mantém o seed automático na primeira inicialização para a apresentação da faculdade
ALLOW_DEMO_SEED=true
