# Copy to .env.local and adjust. Values are read by Vite at build/dev time.
# Leave commented out to automatically use http://<current-hostname>:3000 (works with localhost, LAN, and Tailscale).
# VITE_API_URL=http://localhost:3000

# Set to "false" to call the real API instead of the mock data in src/mocks
VITE_USE_MOCKS=true
